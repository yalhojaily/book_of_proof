---
import { sectionPages, PDF_PAGE_OFFSET } from './pages';
import { url } from '@/lib/url';

interface Props { section: string; kind: 'reading' | 'exercises' | 'solutions' }
const { section, kind } = Astro.props;
const strips = sectionPages(section)[kind];
const pdf = url('book/book-of-proof.pdf');
---
{strips.length > 0 && (
  <div class={`book book-${kind}`}>
    {strips.map((s, i) => {
      const newPage = i === 0 || strips[i - 1].page !== s.page;
      return (
        <>
          {newPage && (
            <div class="pg-mark">
              <span>صفحة <b class="ltr">{s.page}</b></span>
              <a href={`${pdf}#page=${s.page + PDF_PAGE_OFFSET}`} target="_blank" rel="noopener">افتح في الكتاب ↗</a>
            </div>
          )}
          <img src={url(s.src)} width={s.w} height={s.h} loading="lazy" decoding="async" alt={`Book of Proof، صفحة ${s.page}`} />
        </>
      );
    })}
  </div>
)}
<style>
  .book { direction: ltr; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow); padding: 6px 4px 14px; margin: 1em 0 1.6em; }
  .book img { display: block; width: 100%; max-width: 680px; height: auto; margin: 0 auto; }
  .pg-mark { direction: rtl; display: flex; justify-content: space-between; align-items: center; max-width: 680px; margin: 10px auto 4px; padding: 0 12px; font-family: var(--font-ui); font-size: 12.5px; color: #8a8f99; border-top: 1px dashed #e3e0d8; padding-top: 6px; }
  .pg-mark:first-child { border-top: 0; margin-top: 2px; }
  .pg-mark a { color: #8a8f99; text-decoration: none; }
  .pg-mark a:hover { color: #2f5fd0; }
  :global(html.is-dark) .book { background: #16181e; }
  :global(html.is-dark) .book img { filter: invert(0.9) hue-rotate(180deg) contrast(0.95); }
  :global(html.is-dark) .pg-mark { color: #7d828c; border-color: #2a2e38; }
  :global(html.is-dark) .pg-mark a { color: #7d828c; }
</style>
